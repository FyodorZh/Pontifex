<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>9</LangVersion>
        <Nullable>enable</Nullable>
        <Version>0.1.2-dev.0</Version>
        <Title>Pontifex</Title>
        <Authors>Fyodor Zhmaev</Authors>
        <Description>Generalized transport library</Description>
        <Copyright>Copyright (c) Fyodor Zhmaev 2026</Copyright>
        <PackageProjectUrl>https://github.com/FyodorZh/Pontifex</PackageProjectUrl>
        <RepositoryUrl>https://github.com/FyodorZh/Pontifex.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>nuget.readme.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="nuget.readme.md" Pack="true" PackagePath="\" />
        <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Actuarius.Memory" Version="0.1.4-dev.0" />
      <PackageReference Include="Operarius" Version="0.2.2-dev.0" />
      <PackageReference Include="Scriba" Version="0.2.4-dev.0" />
      <PackageReference Include="System.Text.Json" Version="11.0.0-preview.5.26302.115" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Elements\" />
      <Folder Include="Wrappers\" />
    </ItemGroup>

</Project>
